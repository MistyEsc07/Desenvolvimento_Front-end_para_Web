*{
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
}

html{
    font-size: 62.5%;
    scroll-behavior: smooth;
}

body{
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.6rem;}

header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #6E7A3C;
    position: fixed;
    width: 100%;
    top: 0;
    box-shadow: 0 2px 10px (rgba(214, 208, 208, 0.1));
    padding: 10px 20px;
     min-height: 60px;
}

.logo{
    font-size: 2rem;
    font-weight: 700;
    color: #dddbd3;
    text-shadow: 1px 1px #000000;
    text-decoration: none;
    padding-left: 20px;
}

.navbar ul{
    display: flex;
    list-style: none;
    gap: 5px;
}

.navbar a:link, navbar a:visited{
    text-decoration: none;
    padding: 10px 15px;
    color: #FFFFFF;
    text-shadow: 1px 1px 1px #000000;
    border-radius: 5px;
    transition: background-color 0.3s ease;
}

.navbar a:hover, .navbar a:active{
    background-color: #BF9517;
}

#hero{
    background-image: url('../img/hero.jpg');
    width: 100%;
    height: 100vh;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
}

h1{
    text-align: center;
    padding: 40px 0;
    font-size: 3rem;
}

section{
    padding: 50px 20px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

#about{
    background-color: #815E52;
} 

#about p{
    font-size: 2rem;
    text-align: center;
    line-height: 2.6rem;
    max-width: 800px;
    margin: 0 auto;
    padding: 12px;
}

#atletas{
    background-color: #23526e;
    display: block;
    text-align: center;
}

#atletas img{
    width: 300px;
    height: 200px;
    object-fit: cover;
    display: inline-block;
    margin: 15px;
    border: 2px solid #FFFFFF;
    border-radius: 15px;
    box-shadow: 5px 5px 20px rgb(13, 13, 13, 0.5);
    transition: transform 0.3s ease;
}

#atletas img:hover{
    transform: scale(1.05);
}

#curiosidades{
    background-color: #3A3259;
    color: #FFFFFF;
    text-align: center;
    
}

#curiosidades p{
    font-size: 1.8rem;
    line-height: 2.6rem;
    max-width: 800px;
    margin: 0 auto;
    padding: 12px;
    text-align: justify;
    line-height: 2.6rem;
}

#curiosidades img{
    width: 500px;
    height: 300px;
    object-fit: cover;
    display: inline-block;
    margin: center;
    border: 2px solid #FFFFFF;
    border-radius: 15px;
    box-shadow: 5px 5px 20px rgb(13, 13, 13, 0.5);
    transition: transform 0.3s ease;
}

#curiosidades    img:hover{
    transform: scale(1.05);
}
#map{
    padding: 0 !important;
}

#contact{
    background-color: #733924;
    align-items: center;
}

#contact form{
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    text-align: left;
}

#contact label{
    font-size: 1.6rem;
    margin-bottom: 5px;
    font-weight: bold;
}

#contact input, #contact textarea{
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 1.4rem;
    border: none;
    border-radius: 8px;
}

#contact button{
    background-color: #BF9517;
    color: #FFFFFF;
    font-size: 1.6rem;
    padding: 12px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
}

#contact button:hover{
    background-color: #8C3503;
}

footer{
    background-color: #733924;
    text-decoration: none;
    font-weight: bold;
}
